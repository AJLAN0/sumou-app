# Example environment file — SAFE placeholders only. Copy to `.env` and fill in
# locally. NEVER commit a real `.env` (it is gitignored).
#
# Sprint 9 Step 1: documentation of required values. Flutter is NOT wired to
# Supabase yet, and no packages are added — these are consumed later.

# --- Public client values (safe to ship in the Flutter app) ---------------
# The anon key is a public, RLS-gated key. It is NOT a secret in the sense of
# service_role, but real values still must not be committed to source control.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Supabase CLI (local/dev only; not used by the Flutter app) -----------
# Needed only if/when linking the CLI to a remote DEV project (later, and only
# with explicit approval — see docs/SUPABASE_DEV_SETUP.md).
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# --- NEVER put this in Flutter or commit it anywhere -----------------------
# service_role bypasses RLS and belongs only in trusted server contexts
# (e.g. a future Edge Function's secrets). Do NOT define it here in a committed
# file; set it via the Supabase dashboard / CLI secrets instead.
# SUPABASE_SERVICE_ROLE_KEY=  # <- do not commit; server-only
